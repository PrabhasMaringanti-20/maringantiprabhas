{
  "expo": {
    "name": "Multiverse Roadmap",
    "slug": "multiverse-doomsday",
    "version": "1.0.0",
    "description": "Track your way through the MCU before Avengers: Doomsday — watch paths, a character codex, a tier board and a live countdown.",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "multiversedoomsday",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0813",
    "primaryColor": "#10B981",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.multiverse.doomsday"
    },
    "android": {
      "package": "com.multiverse.doomsday",
      "adaptiveIcon": {
        "backgroundColor": "#0B0813",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0813",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#10B981",
          "defaultChannel": "doomsday-countdown"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
